APP_NAME=InfraSphere AI
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./data/infrasphere.db
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
VECTOR_STORAGE_PATH=./data/qdrant
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
FFWC_ENABLED=false
FFWC_API_BASE_URL=
FFWC_API_KEY=
OSM_ENABLED=false
MAX_AGENT_STEPS=8
MAX_AGENT_RETRIES=2
MAX_AGENT_DURATION_SECONDS=120
MAX_PARALLEL_AGENTS=3
ENABLE_DEMO_DATA=true
ENABLE_SYNTHETIC_INCIDENTS=true
